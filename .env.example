API_HOST=127.0.0.1
API_PORT=4000
WALLET_API_URL=http://127.0.0.1:4000
WHATSAPP_HOST=127.0.0.1
WHATSAPP_PORT=4001
RECONCILE_INTERVAL_MS=5000

# API y worker: Supabase Testnet > Connect > Session pooler (5432).
# Codifica los caracteres reservados de la contraseña antes de construir la URL.
# DATABASE_URL=postgresql://ROLE.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# API v1: conexión privada del rol wallet_api; no incluyas credenciales en Git.
# En hosts remotos se exige TLS con verificación del servidor (sslmode=verify-full).
# WALLET_API_DATABASE_URL=

# MCP stdio: configuración privada del cliente local.
# WALLET_MCP_CARD_ID=
# WALLET_MCP_TOKEN=

# Worker: deshabilitado por defecto; fixture nunca envía Stellar.
# WORKER_MODE=fixture
# WORKER_DATABASE_URL=
# WORKER_LEASE_SECONDS=30

# Preflight Testnet no está conectado al worker y no permite difusión.
# La clave AEAD se inyecta desde un almacén externo; nunca se escribe aquí.
